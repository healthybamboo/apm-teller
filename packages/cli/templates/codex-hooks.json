{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "apm-teller validate --hook", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "apm-teller validate --all --hook", "timeout": 60 }
        ]
      }
    ]
  }
}
