{
  "name": "apm-teller",
  "version": "0.1.0",
  "description": "GUI + insight miner for Microsoft APM marketplace repos. Everything lives in the vault repo as text.",
  "type": "module",
  "bin": {
    "apm-teller": "./dist/index.js",
    "teller": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "public"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-web.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts serve"
  },
  "dependencies": {
    "@apm-teller/core": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.3.1",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.14",
    "node-pty": "^1.1.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/healthybamboo/apm-teller.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/healthybamboo/apm-teller#readme",
  "keywords": [
    "apm",
    "agent-package-manager",
    "claude-code",
    "codex",
    "marketplace"
  ]
}
